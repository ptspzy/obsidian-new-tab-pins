{
  "name": "obsidian-new-tab-pins",
  "version": "0.1.1",
  "packageManager": "pnpm@10.16.1",
  "description": "Turn every empty Obsidian tab into a calm launcher for pinned notes, instant search, and recent files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/privacy-policy.node-test.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "privacy:check": "node scripts/privacy-check.mjs --all",
    "privacy:artifacts": "node scripts/privacy-check.mjs --artifacts",
    "privacy:staged": "node scripts/privacy-check.mjs --staged",
    "privacy:gitleaks": "node scripts/run-gitleaks.mjs",
    "privacy:full": "pnpm privacy:check && pnpm privacy:gitleaks",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "pnpm privacy:check && pnpm lint && pnpm test && pnpm build && pnpm privacy:artifacts && pnpm verify:release",
    "release:stage": "pnpm release:check && node scripts/stage-release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "new-tab",
    "pinned-notes"
  ],
  "author": "Joah Peng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ptspzy/obsidian-new-tab-pins.git"
  },
  "bugs": {
    "url": "https://github.com/ptspzy/obsidian-new-tab-pins/issues"
  },
  "homepage": "https://github.com/ptspzy/obsidian-new-tab-pins#readme",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.8"
  }
}
